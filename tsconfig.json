{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "esnext",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "src/store/myStore.ts",
    "packages/emulator/src/emulator.worker.ts",
    "packages/emulator/src/emulator11/alu.ts",
    "packages/emulator/src/emulator11/cpu.ts",
    "packages/emulator/src/emulator11/Emulator.tsx",
    "src/emulator/EmulatorWebviewPanel.ts",
    "packages/emulator/src/emulator11/flags.ts",
    "packages/emulator/src/emulator11/flags2.ts",
    "packages/emulator/src/emulator11/instructions.ts",
    "packages/emulator/src/emulator11/io.ts",
    "packages/emulator/src/emulator11/memory.ts",
    "packages/emulator/src/emulator11/programCounter.ts",
    "packages/emulator/src/emulator11/register.ts",
    "packages/emulator/src/emulator11/symbols.ts",
    "src/emulator/webviewContent.ts",
    "packages/emulator/src/api.ts"
  ]
}
